{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "amiga-assembly",
			"request": "launch",
			"name": "FS-UAE A1200 Debug",
			"stopOnEntry": false,
            "trace": true,
			"program": "${workspaceFolder}/uae/dh0/DrawPoly",
			"remoteProgram": "SYS:DrawPoly",
			"emulatorType": "fs-uae",
			"emulatorArgs": [
				"--chip_memory=2048",
				"--hard_drive_0=${workspaceFolder}/uae/dh0",
				"--joystick_port_1=none",
				"--amiga_model=A1200",
				"--fast_memory=2048",
				"--remote_debugger=200",
				"--use_remote_debugger=true",
				"--automatic_input_grab=0",
				"--video_sync=off",
				"--window_width=692",
				"--window_height=540"
			],
			"preLaunchTask": "amigaassembly: build"
		},
		{
			"type": "amiga-assembly",
			"request": "launch",
			"name": "FS-UAE A500+ Debug",
			"stopOnEntry": false,
            "trace": true,
			"program": "${workspaceFolder}/uae/dh0/DrawPoly",
			"remoteProgram": "SYS:DrawPoly",
			"emulatorType": "fs-uae",
			"emulatorArgs": [
				"--chip_memory=1024",
				"--hard_drive_0=${workspaceFolder}/uae/dh0",
				"--joystick_port_1=none",
				"--amiga_model=A500+",
				"--fast_memory=1024",
				"--remote_debugger=200",
				"--use_remote_debugger=true",
				"--automatic_input_grab=0",
				"--video_sync=off",
				"--window_width=692",
				"--window_height=540"
			],
			"preLaunchTask": "amigaassembly: build"
		},
		{
			"type": "amiga-assembly",
			"request": "launch",
			"name": "FS-UAE A1200 Run",
			"noDebug": true,
			"program": "${workspaceFolder}/uae/dh0/DrawPoly",
			"remoteProgram": "SYS:DrawPoly",
			"emulatorType": "fs-uae",
			"emulatorArgs": [
				"--chip_memory=2048",
				"--hard_drive_0=${workspaceFolder}/uae/dh0",
				"--joystick_port_1=none",
				"--amiga_model=A1200",
				"--fast_memory=2048",
				"--automatic_input_grab=0",
				"--video_sync=off",
				"--window_width=692",
				"--window_height=540"
			],
			"preLaunchTask": "amigaassembly: build"
		},
		{
			"type": "amiga-assembly",
			"request": "launch",
			"name": "FS-UAE A500+ Run",
			"noDebug": true,
			"program": "${workspaceFolder}/uae/dh0/DrawPoly",
			"remoteProgram": "SYS:DrawPoly",
			"emulatorType": "fs-uae",
			"emulatorArgs": [
				"--chip_memory=1024",
				"--hard_drive_0=${workspaceFolder}/uae/dh0",
				"--joystick_port_1=none",
				"--amiga_model=A500+",
				"--fast_memory=1024",
				"--automatic_input_grab=0",
				"--video_sync=off",
				"--window_width=692",
				"--window_height=540"
			],
			"preLaunchTask": "amigaassembly: build"
		},
		{
			"type": "amiga-assembly",
			"request": "launch",
			"name": "WinUAE A500 Debug",
			"stopOnEntry": true,
            "trace": true,
			"program": "${workspaceFolder}/uae/dh0/DrawPoly",
			"remoteProgram": "SYS:DrawPoly",
			"emulatorType": "winuae",
			"emulatorArgs": [
				"-s",
				"quickstart=a500,1",
				"-s",
				"filesystem=rw,dh0:${workspaceFolder}/uae/dh0",
				"-r",
				"${workspaceFolder}/uae/rom/Kickstart v2.04 rev 37.175 (1991)(Commodore)(A500+).rom"
			],
			"preLaunchTask": "amigaassembly: build"
		},
